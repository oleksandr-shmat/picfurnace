{
	frankenphp
}

# APP_DOMAIN comes from the environment (the .env file next to compose.prod.yml).
# Caddy gets and renews the HTTPS certificate for it by itself.
{$APP_DOMAIN} {
	root * /app/public
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}

	php_server
}
